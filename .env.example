# Keel configuration. Copy to .env and fill in. Lines marked (required) must be set in production.

# --- Meta Model API (https://api.meta.ai/v1, OpenAI-compatible) ---
META_API_KEY=                       # (required) Meta Model API key
META_API_BASE=https://api.meta.ai/v1
MODEL_SPARK=muse-spark-1.3          # check the exact ids with: curl -H "Authorization: Bearer $META_API_KEY" $META_API_BASE/models
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
META_ASR_WS=wss://api.meta.ai/v1/asr/realtime

# --- Open-weight screening tier (optional; without it Muse Spark screens too) ---
OPENWEIGHT_BASE_URL=https://inference.baseten.co/v1
OPENWEIGHT_API_KEY=
OPENWEIGHT_MODEL=meta-models/muse-spark-open-1026

# --- Meta Marketing API ---
META_GRAPH_VERSION=v24.0
META_SYSTEM_USER_TOKEN=             # used for accounts added by ID (no Facebook connection)
META_AD_ACCOUNT_ID=                 # optional: `npm run account:add` registers this one
KEEL_INCLUDE_PAUSED=0               # 1 = also watch paused ads (handy for zero-spend test accounts)

# --- Facebook Login for Business (sign-in + ad permissions in one step) ---
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=               # Login for Business configuration id

# --- Meta Ads MCP (optional) ---
META_ADS_MCP_URL=https://mcp.facebook.com/ads
META_ADS_MCP_TOKEN=

# --- Keel Bridge (web + API) ---
DATABASE_URL=postgres://keel:keel@localhost:5432/keel   # (required)
KEEL_SECRET=change-me               # (required) 32+ chars: openssl rand -hex 32. Signs sessions, encrypts Meta tokens
PORT=8787
PUBLIC_BASE_URL=http://localhost:5173   # (required) the URL people open. Dev: Vite on 5173. Prod: https://your-domain
WEB_BASE_URL=http://localhost:5173      # same as PUBLIC_BASE_URL in production
DEMO_ENABLED=1                      # "Explore the demo" on the sign-in page
DEV_AUTH=1                          # local-only developer sign-in; must be 0 in production
MEDIA_DIR=                          # where captured images live (default .data/media; /data/media in Docker)

# --- Web push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Watch cycle ---
VARIANT_SOURCE=meta,fixtures        # meta = render Meta's ad previews; fixtures = eval/fixtures/<adId>/variant-*.png
PREVIEW_PLACEMENTS=MOBILE_FEED_STANDARD,INSTAGRAM_STANDARD,INSTAGRAM_STORY
SCHEDULER_TICK_SEC=60               # how often the worker looks for due accounts (each account has its own interval)
MAX_PARALLEL_CYCLES=2
SAM_DISABLED=0                      # 1 = compare whole images instead of SAM regions
SAM_DEBUG=0                         # 1 = log SAM's raw response (to confirm its format)
INVESTIGATOR_DISABLED=0             # 1 = skip the Muse Wonder second look
