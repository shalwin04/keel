# --- Meta Model API (https://api.meta.ai/v1, OpenAI-compatible) ---
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MODEL_SPARK=muse-spark-1.3          # verify exact id on day 1
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0          # verify
MODEL_SAM=sam-3.1
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
META_ASR_WS=wss://api.meta.ai/v1/asr/realtime

# --- Open-weight screening tier (OpenAI-compatible) ---
OPENWEIGHT_BASE_URL=https://inference.baseten.co/v1   # verify
OPENWEIGHT_API_KEY=
OPENWEIGHT_MODEL=meta-models/muse-spark-open-1026

# --- Meta Marketing API ---
META_GRAPH_VERSION=v24.0            # use the current Graph API version
META_SYSTEM_USER_TOKEN=             # fallback when an account has no Facebook Login connection
META_AD_ACCOUNT_ID=act_000000000000 # account the worker checks on a schedule

# --- Facebook Login for Business (Keel Bridge sign-in + ad permissions) ---
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=               # Login for Business configuration id

# --- Meta Ads MCP (optional) ---
META_ADS_MCP_URL=https://mcp.facebook.com/ads
META_ADS_MCP_TOKEN=

# --- Keel Bridge ---
DATABASE_URL=postgres://keel:keel@localhost:5432/keel
KEEL_SECRET=change-me               # signs sessions, encrypts Meta tokens
API_PORT=8787
PUBLIC_BASE_URL=http://localhost:5173   # where the browser reaches /auth (the Vite proxy in dev)
WEB_BASE_URL=http://localhost:5173
DEMO_ENABLED=1                      # "Explore the demo workspace" on the sign-in page
DEV_AUTH=1                          # local-only developer sign-in; never set in production

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Watch cycle ---
VARIANT_SOURCE=fixtures             # fixtures | meta
POLL_INTERVAL_MIN=180
SAM_DISABLED=                       # set to 1 to compare whole images instead of SAM regions
