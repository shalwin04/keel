{
  "name": "keel",
  "private": true,
  "version": "0.1.0",
  "description": "Keel keeps your brand steady while Meta's AI steers your ads.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:api": "npm run dev -w @keel/api",
    "dev:worker": "npm run dev -w @keel/worker",
    "dev:web": "npm run dev -w @keel/web",
    "cycle:once": "npm run once -w @keel/worker",
    "eval": "tsx eval/run.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:local": "tsx scripts/db-local.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
